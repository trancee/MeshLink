{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handshake-xx.schema.json",
  "title": "MeshLink protocol 1 test vectors: handshake-xx.json",
  "type": "object",
  "required": [
    "tier",
    "algorithm",
    "schema",
    "generatorVersion",
    "numberOfTests",
    "notes",
    "testGroups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tier": {
      "const": 2
    },
    "algorithm": {
      "type": "string"
    },
    "schema": {
      "const": "handshake-xx.schema.json"
    },
    "generatorVersion": {
      "type": "string"
    },
    "numberOfTests": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "object"
    },
    "testGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "protocol",
          "gated",
          "tests"
        ],
        "properties": {
          "type": {
            "const": "NoiseHandshake"
          },
          "protocol": {
            "enum": [
              "Noise_XX_25519_ChaChaPoly_SHA256",
              "Noise_XXpsk3_25519_ChaChaPoly_SHA256"
            ]
          },
          "gated": {
            "type": "boolean"
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "tcId",
                "comment",
                "flags",
                "result",
                "now",
                "initiator",
                "responder",
                "initiator_node_id",
                "responder_node_id",
                "payloads",
                "messages"
              ],
              "properties": {
                "tcId": {
                  "type": "integer",
                  "minimum": 1
                },
                "comment": {
                  "type": "string"
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "result": {
                  "enum": [
                    "valid",
                    "invalid"
                  ]
                },
                "now": {
                  "type": "integer",
                  "minimum": 0
                },
                "initiator": {
                  "type": "object",
                  "required": [
                    "static_private",
                    "ephemeral_private",
                    "prologue"
                  ],
                  "properties": {
                    "static_private": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "ephemeral_private": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "prologue": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})*$"
                    },
                    "mesh_key": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "psk": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "responder": {
                  "type": "object",
                  "required": [
                    "static_private",
                    "ephemeral_private",
                    "prologue"
                  ],
                  "properties": {
                    "static_private": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "ephemeral_private": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "prologue": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})*$"
                    },
                    "mesh_key": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "psk": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "initiator_node_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "responder_node_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "payloads": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                },
                "messages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                },
                "tampered_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "rejected_step": {
                  "type": "integer",
                  "minimum": 1
                },
                "handshake_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "transport": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "direction",
                      "plaintext",
                      "ciphertext"
                    ],
                    "properties": {
                      "direction": {
                        "enum": [
                          "initiator-to-responder",
                          "responder-to-initiator"
                        ]
                      },
                      "plaintext": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{2})*$"
                      },
                      "ciphertext": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{2})*$"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
