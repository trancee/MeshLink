{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lookup-reply.schema.json",
  "title": "MeshLink protocol 1 test vectors: lookup-reply.json",
  "type": "object",
  "required": [
    "tier",
    "algorithm",
    "schema",
    "generatorVersion",
    "numberOfTests",
    "notes",
    "testGroups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tier": {
      "const": 2
    },
    "algorithm": {
      "type": "string"
    },
    "schema": {
      "const": "lookup-reply.schema.json"
    },
    "generatorVersion": {
      "type": "string"
    },
    "numberOfTests": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "object"
    },
    "testGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "tests"
        ],
        "properties": {
          "type": {
            "const": "LookupReplySeal"
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "tcId",
                "comment",
                "flags",
                "result",
                "target_node_id",
                "now",
                "certificate",
                "salt",
                "lookup_tag",
                "requester_ephemeral",
                "responder_ephemeral"
              ],
              "properties": {
                "tcId": {
                  "type": "integer",
                  "minimum": 1
                },
                "comment": {
                  "type": "string"
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "result": {
                  "enum": [
                    "valid",
                    "invalid"
                  ]
                },
                "target_node_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "now": {
                  "type": "integer",
                  "minimum": 0
                },
                "certificate": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                "salt": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                "lookup_tag": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                "requester_ephemeral": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "responder_ephemeral": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "requester_private": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "responder_private": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "shared_secret": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "sealed": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
