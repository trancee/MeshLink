{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e-sessions.schema.json",
  "title": "MeshLink protocol 1 test vectors: e2e-sessions.json",
  "type": "object",
  "required": [
    "tier",
    "algorithm",
    "schema",
    "generatorVersion",
    "numberOfTests",
    "notes",
    "testGroups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tier": {
      "const": 2
    },
    "algorithm": {
      "type": "string"
    },
    "schema": {
      "const": "e2e-sessions.schema.json"
    },
    "generatorVersion": {
      "type": "string"
    },
    "numberOfTests": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "object"
    },
    "testGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "protocol",
          "profile",
          "initiator",
          "responder",
          "responder_key",
          "first_message_id",
          "payload_1",
          "message_1",
          "receipt_plaintext",
          "handshake_hash",
          "tests"
        ],
        "properties": {
          "type": {
            "const": "E2ESession"
          },
          "protocol": {
            "enum": [
              "Noise_IK_25519_ChaChaPoly_SHA256",
              "Noise_IKhfs_25519+MLKEM768_ChaChaPoly_SHA256"
            ]
          },
          "profile": {
            "enum": [
              1,
              2
            ]
          },
          "initiator": {
            "type": "object",
            "required": [
              "static_private",
              "ephemeral_private",
              "prologue"
            ],
            "properties": {
              "static_private": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ephemeral_private": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kem_keygen_seed": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              },
              "prologue": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            },
            "additionalProperties": false
          },
          "responder": {
            "type": "object",
            "required": [
              "static_private",
              "ephemeral_private",
              "prologue"
            ],
            "properties": {
              "static_private": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ephemeral_private": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kem_encaps_seed": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "prologue": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            },
            "additionalProperties": false
          },
          "responder_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "first_message_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "payload_1": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$"
          },
          "message_1": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$"
          },
          "receipt_plaintext": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$"
          },
          "handshake_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "tcId",
                "comment",
                "flags",
                "result",
                "container_2",
                "frames"
              ],
              "properties": {
                "tcId": {
                  "type": "integer",
                  "minimum": 1
                },
                "comment": {
                  "type": "string"
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "result": {
                  "enum": [
                    "valid",
                    "invalid"
                  ]
                },
                "container_2": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                "frames": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "nonce",
                      "plaintext",
                      "container"
                    ],
                    "properties": {
                      "from": {
                        "enum": [
                          "initiator",
                          "responder"
                        ]
                      },
                      "nonce": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "plaintext": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{2})*$"
                      },
                      "container": {
                        "type": "string",
                        "pattern": "^([0-9a-f]{2})*$"
                      },
                      "error": {
                        "enum": [
                          "replayed-nonce",
                          "nonce-below-window",
                          "open-failed"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
