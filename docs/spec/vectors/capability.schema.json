{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability.schema.json",
  "title": "MeshLink protocol 1 test vectors: capability.json",
  "type": "object",
  "required": [
    "algorithm",
    "schema",
    "generatorVersion",
    "numberOfTests",
    "notes",
    "testGroups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "algorithm": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "generatorVersion": {
      "type": "string"
    },
    "numberOfTests": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "object"
    },
    "testGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layout",
          "tests"
        ],
        "properties": {
          "layout": {
            "type": "string"
          },
          "secured": {
            "type": "boolean"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tcId",
                "comment",
                "flags",
                "result",
                "encoded"
              ],
              "properties": {
                "tcId": {
                  "type": "integer",
                  "minimum": 1
                },
                "comment": {
                  "type": "string"
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "result": {
                  "enum": [
                    "valid",
                    "invalid",
                    "acceptable"
                  ]
                },
                "encoded": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                },
                "decoded": {
                  "type": "object"
                },
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
