{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codes.schema.json",
  "title": "MeshLink protocol 1 small code registries",
  "type": "object",
  "required": [
    "title",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "registry",
          "code",
          "name",
          "decision",
          "source"
        ],
        "properties": {
          "registry": {
            "enum": [
              "profile",
              "advertisement-flag",
              "handshake-step",
              "close-reason",
              "busy-reason",
              "container-kind",
              "conversation-direction"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^0x[0-9A-F]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "pattern": "^(-|D-[0-9]{2})$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
