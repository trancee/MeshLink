{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "limits.schema.json",
  "title": "MeshLink protocol 1 limits and timers",
  "type": "object",
  "required": [
    "title",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "decision",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "B",
              "s",
              "ms",
              "-",
              "epochs",
              "versions",
              "handshakes",
              "records",
              "streams",
              "entries",
              "hops",
              "messages",
              "attempts",
              "nonces"
            ]
          },
          "decision": {
            "type": "string",
            "pattern": "^(-|D-[0-9]{2})$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
