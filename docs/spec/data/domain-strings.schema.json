{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-strings.schema.json",
  "title": "MeshLink protocol 1 domain-separation strings",
  "type": "object",
  "required": [
    "title",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "purpose",
          "string",
          "primitive",
          "section",
          "source"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "string": {
            "type": "string",
            "pattern": "^MeshLink/1 [a-z0-9-]+$"
          },
          "primitive": {
            "type": "string"
          },
          "section": {
            "enum": [
              "identity.md",
              "discovery.md",
              "link.md",
              "routing.md",
              "end-to-end.md"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
