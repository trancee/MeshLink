{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tlv-types.schema.json",
  "title": "MeshLink protocol 1 TLV types",
  "type": "object",
  "required": [
    "title",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "context",
          "code",
          "name",
          "critical",
          "length",
          "decision",
          "source"
        ],
        "properties": {
          "context": {
            "enum": [
              "capability",
              "handshake",
              "e2e"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^0x[0-9A-F]{2}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "critical": {
            "type": "boolean"
          },
          "length": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "decision": {
            "type": "string",
            "pattern": "^(-|D-[0-9]{2})$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
