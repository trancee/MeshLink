{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame-types.schema.json",
  "title": "MeshLink protocol 1 frame types",
  "type": "object",
  "required": [
    "title",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "class",
          "section",
          "decision",
          "source"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^0x[0-9A-F]{2}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "class": {
            "enum": [
              "link-local",
              "unicast",
              "flood"
            ]
          },
          "section": {
            "enum": [
              "link.md",
              "routing.md",
              "end-to-end.md"
            ]
          },
          "decision": {
            "type": "string",
            "pattern": "^(-|D-[0-9]{2})$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
